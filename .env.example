# Copie para ".env" (não versionar) se quiser trocar os valores padrão do docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# LocalStack: por padrão usa a tag comunitária fixada no compose.
# Para a imagem mais nova (exige conta/token gratuito em app.localstack.cloud):
# LOCALSTACK_IMAGE=localstack/localstack:latest
# LOCALSTACK_AUTH_TOKEN=
